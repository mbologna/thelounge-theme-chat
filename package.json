{
  "name": "thelounge-theme-chat",
  "version": "1.3.0",
  "description": "Warm, editorial IRC theme for TheLounge — automatic light/dark, digest-style messages, coloured avatar discs",
  "keywords": [
    "thelounge",
    "thelounge-theme",
    "irc",
    "dark-mode",
    "css-only",
    "accessibility"
  ],
  "main": "package.json",
  "license": "MIT",
  "author": "Michele Bologna",
  "homepage": "https://github.com/mbologna/thelounge-theme-chat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mbologna/thelounge-theme-chat.git"
  },
  "bugs": {
    "url": "https://github.com/mbologna/thelounge-theme-chat/issues"
  },
  "thelounge": {
    "css": "theme.min.css",
    "name": "Chat",
    "type": "theme",
    "themeColor": "#0e0e12"
  },
  "files": [
    "theme.css",
    "theme.min.css"
  ],
  "scripts": {
    "build": "lightningcss --minify theme.css -o theme.min.css",
    "lint": "stylelint theme.css",
    "lint:fix": "stylelint theme.css --fix",
    "pretest": "npm run build",
    "test": "node --test test/*.mjs",
    "check": "npm run lint && npm test",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "lightningcss-cli": "^1.32.0",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0"
  }
}
